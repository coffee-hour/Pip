[Desktop Entry]
Type=Application
Version=1.0
Name=Pip
Comment=Start Pip, the portable companion, and open it in your browser
Icon=utilities-terminal
Terminal=false
Categories=Utility;
Keywords=Pip;AI;companion;
# Relative path: keep this file in the same folder as launch.sh (the Pip folder on the USB stick).
# Runs through bash, so launch.sh does not need the executable bit.
Exec=bash -c 'cd "$(dirname "%k")" && exec bash ./launch.sh'
